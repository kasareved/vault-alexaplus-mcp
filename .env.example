# Copy this file to .env and fill in what you want. NEVER commit .env to GitHub.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Amazon Bedrock (set to 1 to enable the advisor tool)
USE_BEDROCK=0
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Amazon DynamoDB (table with partition key "pk" and sort key "sk", both String)
DYNAMODB_TABLE=

# Google Gemini (photo to listing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
